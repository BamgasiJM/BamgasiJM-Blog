# Google Drive for desktop: use the actual folder path from File Explorer.
# Copy to .env, uncomment BLOG_CONTENT_DIR and replace the example path.
# No Google Cloud account, API key or public sharing is needed.
# BLOG_CONTENT_DIR="G:\My Drive\Blog"
# To preview the existing project Markdown instead:
# BLOG_CONTENT_SOURCE=local
# BLOG_CONTENT_DIR=md
